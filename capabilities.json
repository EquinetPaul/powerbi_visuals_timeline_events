{
    "dataRoles": [
        {
            "displayName": "Date",
            "name": "date",
            "kind": "Grouping"
        },
        {
            "displayName": "Event Name",
            "name": "event",
            "kind": "Grouping"
        },
        {
            "displayName": "Tooltip",
            "name": "tooltip",
            "kind": "GroupingOrMeasure"
        }
    ],
    "objects": {
        "timeline": {
            "properties": {
                "scaling": {
                    "type": {
                        "numeric": true
                    }
                },
                "symbolColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showEventLabels": {
                    "type": {
                        "bool": true
                    }
                },
                "showDates": {
                    "type": {
                        "bool": true
                    }
                },
                "useEventSymbols": {
                    "type": {
                        "bool": true
                    }
                },
                "showLegend": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "date": {
                        "max": 1
                    },
                    "event": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "date"
                            }
                        },
                        {
                            "for": {
                                "in": "event"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltip"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "privileges": []
}
